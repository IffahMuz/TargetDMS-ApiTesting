{
  "name": "targetdms-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript smoke suite generated from the TargetDMS Swagger/OpenAPI spec",
  "scripts": {
    "test": "playwright test",
    "test:get": "cross-env METHODS=GET playwright test",
    "report:detail": "node scripts/build-detail-report.js",
    "dashboard": "node scripts/dashboard.js",
    "report": "node -e \"require('dotenv').config();const p=require('path');require('child_process').spawnSync('npx',['playwright','show-report','\\\"'+p.join(process.env.WORK_DIR||p.join(require('os').tmpdir(),'targetdms-api-tests'),'playwright-html')+'\\\"'],{stdio:'inherit',shell:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}

# Copy to .env and fill in. .env is git-ignored - never commit real secrets.
API_BASE_URL=https://test-dms-api.targetdealer.com

# Swagger UI / spec endpoint is protected with HTTP Basic auth
SWAGGER_USER=
SWAGGER_PASSWORD=

DEALER_GUID=

# Dealer under test: location dealerId, its DMS location id (Dealer/Locations), and a customer used in created orders
DEALER_ID=
LOCATION_DMS_ID=
TEST_CUSTOMER_ID=

# App login (used to fetch a fresh Bearer token via POST /api/v1/Auth/Login)
API_USERNAME=
API_PASSWORD=
API_DMS_DEALER_ID=

# Or supply a ready token instead of the login above (expires quickly)
API_TOKEN=

# Set to true to skip the RevokeToken tests (they can leave the test account unable to log in)
# SKIP_TOKEN_REVOKE=true

# Optional filters
# METHODS=GET,POST,PUT,DELETE
# EXCLUDE=/Auth/,/ChangeRelay/
# REQUEST_TIMEOUT_MS=30000

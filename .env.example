# Copy to .env and fill in. .env is git-ignored - never commit real secrets.
API_BASE_URL=https://test-dms-api.targetdealer.com

# Swagger UI / spec endpoint is protected with HTTP Basic auth
SWAGGER_USER=
SWAGGER_PASSWORD=

DEALER_GUID=

# Dealer under test: location dealerId, its DMS location id (Dealer/Locations), and a customer used in created orders
DEALER_ID=
LOCATION_DMS_ID=
TEST_CUSTOMER_ID=

# App login (used to fetch a fresh Bearer token via POST /api/v1/Auth/Login)
API_USERNAME=
API_PASSWORD=
API_DMS_DEALER_ID=

# Or supply a ready token instead of the login above (expires quickly)
API_TOKEN=

# Set to true to skip the RevokeToken tests (they can leave the test account unable to log in)
# SKIP_TOKEN_REVOKE=true

# Set to true so that global setup is the only Auth/Login call (skips the tests that log in again)
# SINGLE_LOGIN=true

# Optional filters
# METHODS=GET,POST,PUT,DELETE
# EXCLUDE=/Auth/,/ChangeRelay/
# REQUEST_TIMEOUT_MS=30000

# Optional: the second location (its dealerId from Dealer/Locations) that the multi-location tests compare with.
# Left empty, the first other location of the company is used.
# SECOND_LOCATION_DEALER_ID=

# Azure DevOps board: the "Report to ADO board" buttons of the live dashboard (scripts/dashboard.js) create Bugs here.
# ADO_PAT needs the "Work Items (Read & write)" scope. It stays on this machine (.env is git-ignored).
# ADO_ORG_URL=https://dev.azure.com/<organization>
# ADO_PROJECT=
# ADO_PAT=
# ADO_WORK_ITEM_TYPE=Bug
# ADO_AREA_PATH=
# ADO_ITERATION_PATH=
# ADO_ASSIGNED_TO=
